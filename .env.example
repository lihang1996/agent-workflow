# 飞书自建应用凭证（接入飞书那一篇手把手教你创建）
BOT_A_APP_ID=cli_xxx
BOT_A_APP_SECRET=xxx

# 默认执行引擎：claude | codex
DEFAULT_CLI=claude

# CLI 工作目录（可选；Codex 未单独配置时回退到 CLAUDE_WORKDIR）
# CLAUDE_WORKDIR=/path/to/project
# CODEX_WORKDIR=/path/to/project

# Codex 沙箱：read-only | workspace-write | danger-full-access
# CODEX_SANDBOX=workspace-write
