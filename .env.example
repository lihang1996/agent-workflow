# bot 注册文件路径；默认读取 config/bots.json
BOTS_CONFIG=config/bots.json

# 飞书凭证变量名由 bots.json 中的 appIdEnv / appSecretEnv 决定
FEISHU_CEO_ASSISTANT_APP_ID=cli_xxx
FEISHU_CEO_ASSISTANT_APP_SECRET=xxx
FEISHU_PRODUCT_APP_ID=cli_xxx
FEISHU_PRODUCT_APP_SECRET=xxx
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx
FEISHU_REVIEWER_APP_ID=cli_xxx
FEISHU_REVIEWER_APP_SECRET=xxx
FEISHU_TESTER_APP_ID=cli_xxx
FEISHU_TESTER_APP_SECRET=xxx

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 你自己的 open_id（跑通消息链路后从日志 sender= 字段获取）
OWNER_OPEN_ID=ou_xxx

# bots.json 没有填写 workspace 时使用的兜底目录；默认是 Agent OS 当前目录
CLI_WORKDIR=

# Claude Code / Codex / Cursor / ZCode 的模型后端使用各自的用户级配置管理
# 也可以使用 CC Switch 在不同模型服务之间切换
# bots.json 的 defaultCli 可选：claude / codex / cursor / zcode
CURSOR_CLI_COMMAND=
CURSOR_CLI_MODEL=

# ZCode CLI：官方桌面版自带（首版仅按 macOS 验收），不是社区 npm 包 zcode-app-cli
ZCODE_CLI_COMMAND=
# 官方 CLI 自动查找 Built-in Provider 会看错路径。两条必须成对设置，缺一不可。
# 模型在官方 TUI 里选好；不要把密钥拷进仓库，也不要覆盖 ~/.zcode/v2/provider_config.json
# 使用本机展开后的绝对路径（替换示例用户名 leon）；dotenv 不会展开 $HOME 或 ~。
# ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=/Applications/ZCode.app/Contents/Resources/config/provider/zcode-builtin.json
# ZCODE_PERSONAL_PROVIDER_CONFIG_FILE=/Users/leon/.zcode/v2/provider_config.json
