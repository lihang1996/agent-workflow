# 飞书多 Bot 凭证（接入飞书那一篇手把手教你创建）
# 复制为 .env 后填真实值；勿把 Secret 提交到 git
OWNER_OPEN_ID=
# 多 Bot 部署优先配置跨应用稳定身份；user_id 在同租户稳定，union_id 在同开发者应用间稳定。
# OWNER_USER_ID=u_xxx
# OWNER_UNION_ID=on_xxx
# 额外允许操作 Agent OS 的用户，多个 open_id 用逗号分隔
# AGENT_OS_ALLOWED_OPEN_IDS=ou_xxx,ou_yyy
# AGENT_OS_ALLOWED_USER_IDS=u_xxx,u_yyy
# AGENT_OS_ALLOWED_UNION_IDS=on_xxx,on_yyy

# Agent 可访问的可信根目录，多个目录用逗号分隔；默认仅当前项目及已配置工作目录
# AGENT_OS_ALLOWED_ROOTS=/path/to/project-a,/path/to/logs

# 开发工程师 Dev（兼容旧变量 BOT_A_*）
# 角色由 BOT_* 前缀固定映射，无需也不能用 *_ROLE 改写。
# BOT_A_APP_ID=
# BOT_A_APP_SECRET=
BOT_DEV_APP_ID=
BOT_DEV_APP_SECRET=
BOT_DEV_NAME=开发工程师
# BOT_DEV_WORKDIR=/path/to/default/dev/project

# 测试 QA
BOT_QA_APP_ID=
BOT_QA_APP_SECRET=
BOT_QA_NAME=测试工程师
# BOT_QA_WORKDIR=/path/to/default/qa/project

# 产品经理 PM
BOT_PM_APP_ID=
BOT_PM_APP_SECRET=
BOT_PM_NAME=产品经理

# 架构师 Architect
BOT_ARCH_APP_ID=
BOT_ARCH_APP_SECRET=
BOT_ARCH_NAME=架构师

# CEO / 总助
BOT_CEO_APP_ID=
BOT_CEO_APP_SECRET=
BOT_CEO_NAME=CEO助手

# 代码评审 Reviewer
BOT_REVIEWER_APP_ID=
BOT_REVIEWER_APP_SECRET=
BOT_REVIEWER_NAME=代码评审

# 可选：独立运行时审计 / 最终审查飞书 Bot。未配置时回退 QA / Reviewer，但 CLI 会话仍按逻辑角色隔离。
# BOT_RUNTIME_AUDITOR_APP_ID=
# BOT_RUNTIME_AUDITOR_APP_SECRET=
# BOT_RUNTIME_AUDITOR_NAME=运行时审计
# BOT_FINAL_REVIEWER_APP_ID=
# BOT_FINAL_REVIEWER_APP_SECRET=
# BOT_FINAL_REVIEWER_NAME=最终审查

# 默认执行引擎：claude | codex | cursor
DEFAULT_CLI=cursor

# /review 协作最大轮次（评审↔开发）
# COLLAB_MAX_ROUNDS=2

# CEO /pipeline 固定步骤（缺角色会阻断）
# 固定质量链；只能完整声明，不能裁剪或重排。
# PIPELINE_STEPS=pm,architect,dev,review,qa,runtime_audit,final_review,summary
# AGENT_OS_SKILLS_DIR=/absolute/path/to/agent-os/skills

# 全局 CLI 工作目录（话题 /workdir 与 BOT_*_WORKDIR 未设置时回退）
# CLAUDE_WORKDIR=/path/to/project
# CODEX_WORKDIR=/path/to/project
# CURSOR_WORKDIR=/path/to/project

# Cursor Agent CLI（本机 `agent`，可用 CURSOR_CLI 覆盖成 cursor-agent）
# 无头运行优先配置 CURSOR_API_KEY；也可先在同一终端 `agent login`。
# 所有角色固定精确模型 cursor-grok-4.6-high，禁止 Auto 和其它模型。
# CURSOR_API_KEY=
# CURSOR_CLI=agent
CURSOR_MODEL=cursor-grok-4.6-high
# 普通/已审批任务默认 --force --trust --sandbox disabled 才能无头写文件。
# --force 是 YOLO，没有 Claude PreToolUse；高风险仍走飞书 /approval。
# 设 enabled 才收紧沙箱。不要开 Cursor Auto / --auto-review。
# CURSOR_SANDBOX=disabled

# Codex 默认与 Claude dontAsk 对齐：不传 --sandbox，使用 :danger-full-access permission profile。
# 若要收紧，可设 read-only | workspace-write。
# CODEX_SANDBOX=workspace-write
# 关闭后，即使是交付流水线也不会给 Codex 本机网络/绑定（会从 danger-full-access 降到 workspace 无网络）。
# CODEX_LOCAL_NETWORK_ACCESS=true
# 已审批 Codex 默认同样对齐 Claude --dangerously-skip-permissions；要收紧时再设：
# CODEX_APPROVED_SANDBOX=workspace-write

# 仅在 TEST_DATABASE_URL 等连接明确指向隔离测试库、且与开发/生产库不同时开启。
# 允许 QA 对通过预检的测试资源执行 migration/TRUNCATE/DROP/seed；默认不授权。
# AGENT_OS_TEST_RESOURCE_SENTINEL=true

# 单次 CLI 工具调用上限（读文件/改文件/跑命令都算 1 次）。默认 500。
# 长交付容易超过旧默认 200/300；过大则失去失控熔断作用。
# CLI_MAX_TOOL_COUNT=500
# 同一工具+同一目标连续调用多少次视为死循环并终止。0 关闭。
# 另检测滑动窗口同参重复、同一工具两个目标乒乓（警告 10 / 熔断 20，对齐 super-agent 生产口径）。
# Read↔Edit 交错不算乒乓。
# CLI_TOOL_LOOP_STREAK=15

# 交卷格式纠偏：CLI 退出后若只是 RESULT/GATE_RESULT/Spec 结构不合格，同一会话续写一次。
# Claude / Codex / Cursor 共用。0 关闭；上限 2。质量结论（开放 P0、测试失败、fingerprint）不会走这条。
# CLI_FORMAT_REPAIR_ATTEMPTS=1

# 高风险审批有效期（分钟，1~1440；默认 30）
# APPROVAL_TTL_MINUTES=30

# MCP 结构化提问（默认开启；propose_questions / record_answers）
# MCP_ENABLED=true
# Claude 仅用内置 MCP（忽略本机其它 MCP）
# MCP_STRICT=false

# 第七章：每小时服务端日志巡检（在飞书中创建：/schedule logs 1h /absolute/path/server.log）
# 日志任务使用一次性“仅输入分析”会话，不开放工具或旧会话；高风险建议仍需经审批门确认。
# 发布 Spec / 同步评论还需要飞书应用拥有 Docx 创建编辑与 Drive 文件评论权限。
# 云文档评论补偿同步间隔，最小 10000ms，默认 60000ms
# SPEC_REVIEW_SYNC_INTERVAL_MS=60000
