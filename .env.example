# 飞书多 Bot 凭证（接入飞书那一篇手把手教你创建）
# 复制为 .env 后填真实值；勿把 Secret 提交到 git
OWNER_OPEN_ID=ou_xxx

# 开发工程师 Dev（兼容旧变量 BOT_A_*）
BOT_A_APP_ID=cli_xxx
BOT_A_APP_SECRET=xxx
BOT_DEV_APP_ID=cli_xxx
BOT_DEV_APP_SECRET=xxx
BOT_DEV_NAME=开发工程师
BOT_DEV_ROLE=dev
# BOT_DEV_WORKDIR=/path/to/default/dev/project

# 测试 QA
BOT_QA_APP_ID=cli_xxx
BOT_QA_APP_SECRET=xxx
BOT_QA_NAME=测试工程师
BOT_QA_ROLE=qa
# BOT_QA_WORKDIR=/path/to/default/qa/project

# 产品经理 PM
BOT_PM_APP_ID=cli_xxx
BOT_PM_APP_SECRET=xxx
BOT_PM_NAME=产品经理
BOT_PM_ROLE=pm

# 架构师 Architect
BOT_ARCH_APP_ID=cli_xxx
BOT_ARCH_APP_SECRET=xxx
BOT_ARCH_NAME=架构师
BOT_ARCH_ROLE=architect

# CEO / 总助
BOT_CEO_APP_ID=cli_xxx
BOT_CEO_APP_SECRET=xxx
BOT_CEO_NAME=CEO助手
BOT_CEO_ROLE=ceo

# 代码评审 Reviewer
BOT_REVIEWER_APP_ID=cli_xxx
BOT_REVIEWER_APP_SECRET=xxx
BOT_REVIEWER_NAME=代码评审
BOT_REVIEWER_ROLE=reviewer

# 默认执行引擎：claude | codex
DEFAULT_CLI=claude

# /review 协作最大轮次（评审↔开发）
# COLLAB_MAX_ROUNDS=2

# CEO /pipeline 步骤（逗号分隔，缺角色会自动跳过）
# PIPELINE_STEPS=pm,architect,dev,review,qa,summary

# 全局 CLI 工作目录（话题 /workdir 与 BOT_*_WORKDIR 未设置时回退）
# CLAUDE_WORKDIR=/path/to/project
# CODEX_WORKDIR=/path/to/project

# Codex 沙箱：read-only | workspace-write | danger-full-access
# CODEX_SANDBOX=workspace-write

# MCP 结构化提问（默认开启；propose_questions / record_answers）
# MCP_ENABLED=true
# Claude 仅用内置 MCP（忽略本机其它 MCP）
# MCP_STRICT=false

# 第七章：每小时服务端日志巡检（在飞书中创建：/schedule logs 1h /absolute/path/server.log）
# 日志任务仅做只读分析；发现高风险建议后需经审批门确认。
# 发布 Spec / 同步评论还需要飞书应用拥有 Docx 创建编辑与 Drive 文件评论权限。
