{
  "name": "agent-os",
  "version": "0.1.0",
  "description": "Agent OS — 你的个人生产系统（《Agent OS 个人生产系统实战》配套项目）",
  "type": "module",
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env src/index.ts",
    "start:once": "tsx src/index.ts",
    "start:prod": "pnpm build && pnpm verify:dist-contract && node dist/index.js",
    "probe": "tsx src/probe-lark.ts",
    "build": "tsc",
    "probe:cli": "tsx src/probe-cli.ts",
    "mcp:server": "tsx src/mcp/ask-server.ts",
    "verify:dist-contract": "node scripts/verify-dist-contract.mjs",
    "test": "node --import tsx --test --test-concurrency=1 --experimental-test-isolation=none tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
